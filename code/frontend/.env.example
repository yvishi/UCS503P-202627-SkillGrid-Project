# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string (Vercel Postgres / Neon, or any Postgres instance)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js (next-auth v5)
AUTH_URL="http://localhost:3000"
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Only Google accounts on this domain may sign in. Leave unset in local
# dev to allow any Google account.
ALLOWED_EMAIL_DOMAIN="thapar.edu"

# Google OAuth Client (console.cloud.google.com -> APIs & Services -> Credentials)
# Authorized redirect URI to register: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Blob (Storage tab -> Create Database -> Blob, attached to this project)
BLOB_READ_WRITE_TOKEN=""

# OCR.space (ocr.space/ocrapi -> Free API Key) -- used as a fallback when a
# resume PDF has no text layer (scanned/image-only). Free tier caps uploads
# at 1MB and is rate-limited. The shared "helloworld" demo key works for
# quick local testing but is rate-limited across everyone using it -- get
# your own free key for anything beyond that.
OCR_SPACE_API_KEY=""

# GitHub is NOT used for login -- it's connected later, per-user, as an
# evidence source (see lib/github.ts and app/api/github). Register an OAuth
# App at github.com/settings/developers (not an OAuth "GitHub App"):
#   Homepage URL: <AUTH_URL>
#   Authorization callback URL: <AUTH_URL>/api/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Comma-separated emails allowed into /admin (skill report review). Leave
# empty and the admin pages 404 for everyone.
ADMIN_EMAILS=""

# OpenRouter (openrouter.ai/keys) -- powers "Describe your idea" on
# /dashboard/teammates, which breaks a project idea into catalog skills.
# OPENROUTER_MODEL is optional; any OpenRouter chat model id works.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Hackathon import (lib/hackathon-feeds.ts). A daily Vercel Cron (vercel.json)
# pulls open hackathons from Devfolio, Unstop and Devpost; admins can also
# press "Sync now" on /admin/hackathons. Vercel sends CRON_SECRET as a bearer
# token -- generate with: openssl rand -base64 32. Without it the cron route
# refuses every request.
CRON_SECRET=""
# Sources whose new imports are shown to students straight away; the rest wait
# as "Pending" on /admin/hackathons. Unset means "devfolio". Empty = review all.
HACKATHON_AUTOPUBLISH="devfolio"
