# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string (Vercel Postgres / Neon, or any Postgres instance)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js (next-auth v5)
AUTH_URL="http://localhost:3000"
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Only Google accounts on this domain may sign in. Leave unset in local
# dev to allow any Google account.
ALLOWED_EMAIL_DOMAIN="thapar.edu"

# Google OAuth Client (console.cloud.google.com -> APIs & Services -> Credentials)
# Authorized redirect URI to register: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Blob (Storage tab -> Create Database -> Blob, attached to this project)
BLOB_READ_WRITE_TOKEN=""

# OCR.space (ocr.space/ocrapi -> Free API Key) -- used as a fallback when a
# resume PDF has no text layer (scanned/image-only). Free tier caps uploads
# at 1MB and is rate-limited. The shared "helloworld" demo key works for
# quick local testing but is rate-limited across everyone using it -- get
# your own free key for anything beyond that.
OCR_SPACE_API_KEY=""

# GitHub is NOT used for login. It's connected later, per-user, as an
# evidence source (see feature/github-evidence) -- not part of this env file.
